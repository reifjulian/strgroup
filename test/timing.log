../src\strgroup.ado
*! strgroup 1.0.5 25jan2026 by Julian Reif

. 
. ******************************
. * Timing test for strgroup
. * Tests multiple scenarios for optimization benchmarking
. ******************************
. 
. * Number of iterations per test (for averaging)
. local iters = 3

. 
. * Test sizes - smaller for quick checks, larger for scaling analysis
. local sizes 10000 20000 30000

. 
. * Thresholds to test
. local thresholds 0.3

. 
. foreach N of local sizes {
  2. 
.     * Generate random string data (varying lengths 5-15 chars)
.     drop _all
  3.     set seed 98765
  4.     set obs `N'
  5.     gen len = runiformint(5, 15)
  6.     gen rstr = ""
  7.     qui forval x = 1/15 {
  8.         replace rstr = rstr + char(runiformint(65,90)) if `x' <= len
  9.     }
 10.     drop len
 11. 
.     di _n "===== N = `N' ====="
 12. 
.     foreach thresh of local thresholds {
 13. 
.         * Test without 'first' option
.         timer clear 1
 14.         forval i = 1/`iters' {
 15.             cap drop group
 16.             timer on 1
 17.             qui strgroup rstr, gen(group) threshold(`thresh') force
 18.             timer off 1
 19.         }
 20.         qui timer list 1
 21.         local time_basic = r(t1) / `iters'
 22.         qui sum group
 23.         local ngroups = r(max)
 24.         di "  threshold=`thresh', first=no:  " %6.3f `time_basic' "s avg (
> " `ngroups' " groups)"
 25. 
.         * Test with 'first' option
.         timer clear 2
 26.         forval i = 1/`iters' {
 27.             cap drop group
 28.             timer on 2
 29.             qui strgroup rstr, gen(group) threshold(`thresh') force first
 30.             timer off 2
 31.         }
 32.         qui timer list 2
 33.         local time_first = r(t2) / `iters'
 34.         qui sum group
 35.         local ngroups_first = r(max)
 36.         di "  threshold=`thresh', first=yes: " %6.3f `time_first' "s avg (
> " `ngroups_first' " groups)"
 37.     }
 38. }
